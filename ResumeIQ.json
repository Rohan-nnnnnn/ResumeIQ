    {
      "parameters": {
        "promptType": "define",
        "text": "=\nYou are ResumeIQ's resume verification checker.\n\nCompare the rewritten resume against the original resume analysis provided below.\n\nORIGINAL RESUME ANALYSIS:\n{{ JSON.stringify($('Resume Analyzer').item.json.output) }}\n\nREWRITTEN RESUME:\n{{ $json.text }}\n\nCheck for:\n- Invented skills, education, employers, projects, certifications, or dates.\n- Invented numerical metrics or achievements.\n- Claims that were only suggestions in the original analysis.\n- Missing or altered factual details.\n\nReturn valid JSON with these fields:\n{\n  \"verification_status\": \"PASS or REVIEW\",\n  \"unsupported_claims\": [],\n  \"missing_facts\": [],\n  \"corrections_required\": []\n}\n\nUse PASS only if every factual claim in the rewritten resume is supported by the original analysis. Otherwise, use REVIEW and list the problems. Never assume an unverified claim is true.\n",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        3008,
        -112
      ],
      "id": "ea3aa3ad-9289-4ca7-9a51-0d4d5a683750",
      "name": "Verifier"
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        3664,
        -144
      ],
